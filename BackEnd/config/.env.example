# Example environment variables for the backend. Do not commit real values.
# Spring Boot does not read .env files by itself. Either set the variables in the shell before starting, e.g.
#   PowerShell:  $env:DB_URL = "jdbc:sqlserver://..."; .\mvnw.cmd spring-boot:run
# or reference this file from a VS Code launch configuration ("envFile": "${workspaceFolder}/BackEnd/config/.env").
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=procurement_dev;integratedSecurity=true;encrypt=true;trustServerCertificate=true
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev,demo
